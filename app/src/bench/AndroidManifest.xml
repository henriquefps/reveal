<?xml version="1.0" encoding="utf-8"?>
<!-- The bench build only (docs/adr/0019 "Measurements"): profileable, and an activity adb starts to run a measurement.
     The bench app is never distributed; exporting the activity lets `am start` reach it in a non-debuggable build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name="dev.hfps.reveal.bench.BenchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            tools:ignore="ExportedActivity" />
    </application>
</manifest>
