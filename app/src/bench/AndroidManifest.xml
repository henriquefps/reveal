<?xml version="1.0" encoding="utf-8"?>
<!-- The bench build only (docs/adr/0019 "Measurements"): profileable, and an activity adb starts to run a measurement.
     The bench app is never distributed; exporting the activity lets `am start` reach it in a non-debuggable build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name="dev.hfps.reveal.bench.BenchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            tools:ignore="ExportedActivity" />

        <!-- The SAF provider over generated files (src/synthetic, as in debug builds): the 10,000-file library of the
             release-build measurements (docs/adr/0006 "Measurements"). Its own process, like a real provider. -->
        <provider
            android:name="dev.hfps.reveal.debug.SyntheticDocumentsProvider"
            android:authorities="${applicationId}.synthetic"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":documents">
            <intent-filter>
                <action android:name="android.provider.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
